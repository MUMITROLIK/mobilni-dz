<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MemoryGame.Controls.PixelDialog"
             IsVisible="False">

    <!-- Затемнення на весь екран і вікно посередині в піксельному стилі -->
    <Grid BackgroundColor="#B30F0F1A">
        <Border x:Name="Panel" VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="400"
                BackgroundColor="{StaticResource Panel}" Stroke="{StaticResource Ink}" StrokeThickness="6" Padding="24,22">
            <Border.StrokeShape><Rectangle /></Border.StrokeShape>
            <VerticalStackLayout Spacing="20">
                <Label x:Name="TitleLabel" Style="{StaticResource TitleLabel}" FontSize="22" />
                <Label x:Name="MessageLabel" HorizontalTextAlignment="Center" LineHeight="1.7" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button x:Name="AcceptButton" Grid.Column="0" Style="{StaticResource GreenButton}" Clicked="OnAcceptClicked" />
                    <Button x:Name="CancelButton" Grid.Column="1" Style="{StaticResource PixelButton}" Clicked="OnCancelClicked" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>
