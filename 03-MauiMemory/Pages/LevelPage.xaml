<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MemoryGame.Pages.LevelPage"
             Title="Рівні"
             BackgroundColor="#1A1C2C">

    <Grid>
        <Image Source="bg_night.png" Aspect="AspectFill" />

        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="16" WidthRequest="440" Padding="10">

            <Label Text="ОБЕРИ РІВЕНЬ" Style="{StaticResource TitleLabel}" FontSize="26" Margin="0,0,0,10" />

            <!-- Картки рівнів створюються в коді за списком LevelConfig.All -->
            <VerticalStackLayout x:Name="LevelsLayout" Spacing="14" />

            <Button Text="НАЗАД" Style="{StaticResource PixelButton}" Margin="0,8,0,0" Clicked="OnBackClicked" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
