<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Survival.Controls"
             x:Class="Survival.Pages.HomePage"
             Title="Табір"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#1A1C2C">

    <Grid>
        <controls:Backdrop />

        <ScrollView>
            <VerticalStackLayout Padding="18,14" Spacing="14" MaximumWidthRequest="760">

                <controls:HudBar />

                <!-- Герой і його інструменти -->
                <Border BackgroundColor="#CC1A1C2C" Stroke="{StaticResource Ink}" StrokeThickness="4" Padding="16,14">
                    <Border.StrokeShape><Rectangle /></Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
                        <Grid WidthRequest="96" HeightRequest="96" VerticalOptions="Center">
                            <Image x:Name="HeroImage" Source="hero.png" />
                            <!-- Шар для літаючих написів над героєм (хропіння «Z») -->
                            <AbsoluteLayout x:Name="HeroOverlay" InputTransparent="True" />
                        </Grid>
                        <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                            <Label Text="ТВІЙ ТАБІР" TextColor="{StaticResource Gold}" FontSize="14" />
                            <Label x:Name="StatusLabel" Text="" FontSize="9" LineHeight="1.7" LineBreakMode="WordWrap" />
                            <HorizontalStackLayout x:Name="ToolsRow" Spacing="8" />
                        </VerticalStackLayout>
                        <!-- Супутник у таборі (спрайт Kenney, CC0) -->
                        <Image Grid.Column="2" x:Name="WizardImage" Source="k_wizard.png" WidthRequest="96" HeightRequest="96" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Основні дії -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                    <Button Text="ДОСЛІДЖУВАТИ" ImageSource="loc_forest.png" ContentLayout="Top,8" Style="{StaticResource GreenButton}" HeightRequest="110" Clicked="OnExploreClicked" />
                    <Button Grid.Column="1" Text="ІНВЕНТАР" ImageSource="res_wood.png" ContentLayout="Top,8" Style="{StaticResource PixelButton}" HeightRequest="110" Clicked="OnInventoryClicked" />
                    <Button Grid.Row="1" Text="ПРОКАЧКА" ImageSource="tool_sword.png" ContentLayout="Top,8" Style="{StaticResource PixelButton}" HeightRequest="110" Clicked="OnUpgradeClicked" />
                    <Button Grid.Row="1" Grid.Column="1" Text="СПАТИ" ImageSource="icon_sleep.png" ContentLayout="Top,8" Style="{StaticResource PixelButton}" HeightRequest="110" Clicked="OnSleepClicked" />
                    <Button Grid.Row="2" Text="ПОЇСТИ" ImageSource="stat_food.png" ContentLayout="Top,8" Style="{StaticResource PixelButton}" HeightRequest="110" Clicked="OnEatClicked" />
                    <Button Grid.Row="2" Grid.Column="1" Text="ПОПИТИ" ImageSource="stat_thirst.png" ContentLayout="Top,8" Style="{StaticResource PixelButton}" HeightRequest="110" Clicked="OnDrinkClicked" />
                </Grid>

                <Button Text="В МЕНЮ" Style="{StaticResource PixelButton}" BackgroundColor="{StaticResource Red}" Clicked="OnMenuClicked" />
            </VerticalStackLayout>
        </ScrollView>

        <Label x:Name="ToastLabel" IsVisible="False" VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,0,40"
               BackgroundColor="{StaticResource Ink}" TextColor="{StaticResource Gold}" Padding="16,10" FontSize="10" />
    </Grid>
</ContentPage>
