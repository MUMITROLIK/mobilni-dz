<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Survival.Controls"
             x:Class="Survival.Pages.LocationsPage"
             Title="Локації"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#1A1C2C">

    <Grid>
        <controls:Backdrop />

        <ScrollView>
            <VerticalStackLayout Padding="18,14" Spacing="14" MaximumWidthRequest="760">
                <controls:HudBar />

                <Label Text="ДОСЛІДЖЕННЯ" Style="{StaticResource TitleLabel}" FontSize="22" HorizontalOptions="Start" />
                <Label Text="Нові місця відкриваються з рівнем героя." FontSize="9" TextColor="#94B0C2" />

                <!-- Картки локацій створюються в коді за списком Catalog.Locations -->
                <VerticalStackLayout x:Name="LocationsLayout" Spacing="12" />

                <Button Text="НАЗАД" Style="{StaticResource PixelButton}" Clicked="OnBackClicked" />
            </VerticalStackLayout>
        </ScrollView>

        <Label x:Name="ToastLabel" IsVisible="False" VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,0,40"
               BackgroundColor="{StaticResource Ink}" TextColor="{StaticResource Gold}" Padding="16,10" FontSize="10" />
    </Grid>
</ContentPage>
