<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Survival.Controls"
             x:Class="Survival.Pages.MenuPage"
             Title="Меню"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#1A1C2C">

    <Grid>
        <controls:Backdrop />

        <ScrollView VerticalOptions="Center">
            <VerticalStackLayout x:Name="MenuStack" HorizontalOptions="Center" Spacing="12" WidthRequest="400" Padding="10,20">

                <Grid WidthRequest="128" HeightRequest="128" HorizontalOptions="Center">
                    <Image x:Name="Fire" Source="logo_fire.png" />
                    <AbsoluteLayout x:Name="Embers" InputTransparent="True" />
                </Grid>
                <Label Text="ВИЖИВАННЯ" Style="{StaticResource TitleLabel}" FontSize="36" />
                <Label Text="збери ресурси і дожий до ранку" HorizontalOptions="Center" Margin="0,0,0,12" />

                <Button x:Name="ContinueButton" Text="ПРОДОВЖИТИ" ImageSource="icon_play.png" ContentLayout="Left,14"
                        Style="{StaticResource GreenButton}" FontSize="14" HeightRequest="60" Clicked="OnContinueClicked" />
                <Button Text="НОВА ГРА" Style="{StaticResource PixelButton}" Clicked="OnNewGameClicked" />
                <Button x:Name="LoadButton" Text="ЗАВАНТАЖИТИ" Style="{StaticResource PixelButton}" Clicked="OnLoadClicked" />
                <Button x:Name="SaveButton" Text="ЗБЕРЕГТИ" Style="{StaticResource PixelButton}" Clicked="OnSaveClicked" />
                <Button Text="НАЛАШТУВАННЯ" Style="{StaticResource PixelButton}" Clicked="OnSettingsClicked" />
                <Button Text="ВИЙТИ" Style="{StaticResource PixelButton}" BackgroundColor="{StaticResource Red}" Clicked="OnExitClicked" />
            </VerticalStackLayout>
        </ScrollView>

        <Label x:Name="ToastLabel" IsVisible="False" VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,0,40"
               BackgroundColor="{StaticResource Ink}" TextColor="{StaticResource Gold}" Padding="16,10" FontSize="10" />

        <controls:PixelDialog x:Name="Dialog" />
    </Grid>
</ContentPage>
